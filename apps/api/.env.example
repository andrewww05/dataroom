# Copy to .env — the defaults below match the `docker compose up -d` stack in the repo root,
# so nothing here needs hand-editing for local work.

# Port the Nest server listens on. The web dev server proxies /api here.
PORT=3000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Postgres (docker compose service `db`) ---------------------------------
# Prisma at runtime.
DATABASE_URL=postgresql://dataroom:dataroom@localhost:5432/dataroom
# `prisma migrate deploy` — identical locally, and a *direct* (unpooled) URL in production,
# because a connection pooler cannot run migrations.
DIRECT_URL=postgresql://dataroom:dataroom@localhost:5432/dataroom

# --- Blob storage (docker compose service `minio`) --------------------------
# Presigned URLs are signed against this endpoint, so it must be reachable by the browser:
# localhost here, the bucket's public S3 endpoint wherever this is hosted.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dataroom
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO needs path-style addressing; most hosted S3 stores do not.
S3_FORCE_PATH_STYLE=true
